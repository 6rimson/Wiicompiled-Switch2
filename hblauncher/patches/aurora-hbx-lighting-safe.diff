+fn hbx_light1(v: f32) -> i32 {{
+  let finite = (bitcast<u32>(v) & 0x7f800000u) != 0x7f800000u;
+  return i32(round(clamp(select(0.0, v, finite), -65536.0, 65536.0)));
+}}
+
+fn hbx_light3(v: vec3f) -> vec3i {{
+  return vec3i(hbx_light1(v.x), hbx_light1(v.y), hbx_light1(v.z));
+}}
+
+fn hbx_norm(v: vec3f) -> vec3f {{
+  let len2 = dot(v, v);
+  return select(vec3f(0.0), v / sqrt(len2), len2 > 1e-20);
+}}
