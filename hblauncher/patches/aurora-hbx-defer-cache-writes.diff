+extern "C" void aurora_set_cache_writes_deferred(bool deferred) {
+  using namespace aurora;
+  {
+    std::lock_guard lock{gfx::g_pipelineCacheWriterMutex};
+    if (gfx::g_pipelineCacheWritesDeferred == deferred) {
+      return;
+    }
+    gfx::g_pipelineCacheWritesDeferred = deferred;
+    webgpu::set_cache_stores_deferred(deferred);
+  }
+  gfx::g_pipelineCacheWriterCv.notify_one();
+}
