+void set_cache_stores_deferred(bool deferred) { stores_deferred.store(deferred, std::memory_order_release); }
+
+bool has_deferred_stores() {
+  std::lock_guard lock(cache_mutex);
+  return !deferred_stores.empty();
+}
+
+// From the pipeline cache writer thread once a race is over, and at shutdown.
+void flush_deferred_stores() {
+  std::lock_guard lock(cache_mutex);
+  for (const auto& entry : deferred_stores) {
+    store_locked(entry.key.data(), entry.key.size(), entry.value.data(), entry.value.size());
+  }
+  deferred_stores.clear();
+  deferred_bytes = 0;
+}
