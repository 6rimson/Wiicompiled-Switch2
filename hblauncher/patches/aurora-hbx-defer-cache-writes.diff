+// While stores are deferred (races, aurora_set_cache_writes_deferred), new shaders wait here instead
+// of being written to storage from the compiling thread, and the pipeline cache writer thread writes
+// them afterwards. Loads look here first.
+struct DeferredStore {
+  std::vector<uint8_t> key;
+  std::vector<uint8_t> value;
+};
+static std::atomic_bool stores_deferred{false};
+static std::vector<DeferredStore> deferred_stores;
+static size_t deferred_bytes = 0;
+constexpr size_t MaxDeferredBytes = 64u * 1024u * 1024u;
+
+static const DeferredStore* find_deferred(void const* key, size_t keySize) {
+  for (const auto& entry : deferred_stores) {
+    if (entry.key.size() == keySize && std::memcmp(entry.key.data(), key, keySize) == 0) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
