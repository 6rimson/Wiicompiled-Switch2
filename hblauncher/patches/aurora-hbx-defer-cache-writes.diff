+      const auto* valueBytes = static_cast<const uint8_t*>(value);
+      deferred_stores.push_back({{keyBytes, keyBytes + keySize}, {valueBytes, valueBytes + valueSize}});
+      deferred_bytes += keySize + valueSize;
