+#if defined(HBX_SWITCH2)
+// HBLauncher (Switch 2): pipeline creation failed with VK_ERROR_UNKNOWN on worker threads whose
+// stacks live in the runtime's Vulkan-backed memory, which system services cannot access. Workers
+// get SDK-heap stacks, and their number and stack placement can be set from the environment:
+//   AURORA_PIPELINE_THREADS  worker count, 0 = build on the frame thread (default 1)
+//   AURORA_PIPELINE_STACK    "sdk" (default) or "default" (the runtime's own thread stacks)
+struct HbxPipelineThread {
+  pthread_t thread;
+  void* stack;
+};
+static std::vector<HbxPipelineThread> g_hbxPipelineThreads;
+constexpr size_t HbxPipelineStackSize = 8u << 20;
+
+static void* hbx_pipeline_worker_entry(void*) {
+  pipeline_worker();
+  return nullptr;
+}
+
+static unsigned int start_hbx_pipeline_threads() {
+  const char* countEnv = std::getenv("AURORA_PIPELINE_THREADS");
+  const char* stackEnv = std::getenv("AURORA_PIPELINE_STACK");
+  const unsigned int count = countEnv != nullptr ? std::clamp(std::atoi(countEnv), 0, 4) : 1;
+  const bool sdkStack = stackEnv == nullptr || std::strcmp(stackEnv, "default") != 0;
+  unsigned int sdkStacks = 0;
+  for (unsigned int i = 0; i < count; ++i) {
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    void* stack = sdkStack ? hbxl_sdk_memalign(4096, HbxPipelineStackSize) : nullptr;
+    if (stack != nullptr) {
+      pthread_attr_setstack(&attr, stack, HbxPipelineStackSize);
+    }
+    pthread_t thread;
+    if (pthread_create(&thread, &attr, hbx_pipeline_worker_entry, nullptr) != 0) {
+      hbxl_sdk_free(stack);
+      pthread_attr_destroy(&attr);
+      break;
+    }
+    pthread_attr_destroy(&attr);
+    sdkStacks += stack != nullptr ? 1 : 0;
+    g_hbxPipelineThreads.push_back({thread, stack});
+  }
+  Log.info("Pipeline workers: {} ({} on SDK-heap stacks)", g_hbxPipelineThreads.size(), sdkStacks);
+  return static_cast<unsigned int>(g_hbxPipelineThreads.size());
+}
+
+static void join_hbx_pipeline_threads() {
+  for (auto& worker : g_hbxPipelineThreads) {
+    pthread_join(worker.thread, nullptr);
+    hbxl_sdk_free(worker.stack);
+  }
+  g_hbxPipelineThreads.clear();
+}
+#endif
