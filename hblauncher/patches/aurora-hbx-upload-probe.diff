+
+wgpu::Buffer hbx_probe_buffer() {
+  const wgpu::BufferDescriptor descriptor{.label = "HBX upload probe",
+                                          .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                                          .size = 256};
+  return webgpu::g_device.CreateBuffer(&descriptor);
+}
+
+bool hbx_probe_matches(const wgpu::Buffer& buffer, const HbxProbe& probe) {
+  bool ok = false;
+  const auto future = buffer.MapAsync(wgpu::MapMode::Read, 0, 256, wgpu::CallbackMode::WaitAnyOnly,
+                                      [&ok](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                                        ok = status == wgpu::MapAsyncStatus::Success;
+                                      });
+  if (webgpu::g_instance.WaitAny(future, 5000000000) != wgpu::WaitStatus::Success || !ok) {
+    return false;
+  }
+  const bool same = std::memcmp(buffer.GetConstMappedRange(0, 256), probe.expected.data(), probe.bytes) == 0;
+  buffer.Unmap();
+  return same;
+}
+
+void hbx_probe_copy_row(wgpu::CommandEncoder& cmd, const HbxProbe& probe, const wgpu::Buffer& target) {
+  const wgpu::TexelCopyTextureInfo source{.texture = probe.texture, .origin = {.x = 0, .y = probe.row, .z = 0}};
+  const wgpu::TexelCopyBufferInfo destination{.layout = {.bytesPerRow = 256, .rowsPerImage = 1}, .buffer = target};
+  const wgpu::Extent3D extent{probe.bytes / 4, 1, 1};
+  cmd.CopyTextureToBuffer(&source, &destination, &extent);
+}
+
+void hbx_probe_upload(wgpu::CommandEncoder& cmd, FramePacket& frame, const TextureUpload& item, uint64_t stagingOffset) {
+  if (!hbx_probe_enabled() || item.buffer || item.tex.mipLevel != 0 || frame.frameId == s_hbxProbeLastFrame ||
