+void hbx_probe_finish() noexcept {
+  for (auto& probe : s_hbxProbes) {
+    const bool source = hbx_probe_matches(probe.source, probe);
+    const bool dest = hbx_probe_matches(probe.dest, probe);
+    auto later = hbx_probe_buffer();
+    auto encoder = webgpu::g_device.CreateCommandEncoder();
+    hbx_probe_copy_row(encoder, probe, later);
+    const auto commands = encoder.Finish();
+    webgpu::g_queue.Submit(1, &commands);
+    const bool after = hbx_probe_matches(later, probe);
+    uint64_t& count = s_hbxProbeCounts[probe.cleaned ? 1 : 0][(source ? 4 : 0) | (dest ? 2 : 0) | (after ? 1 : 0)];
+    ++count;
+    if (count <= 8) {
+      Log.warn("upload probe: {}x{} row {} staging {} after copy {} later {} cache clean {}", probe.width, probe.height,
+               probe.row, source ? "ok" : "BAD", dest ? "ok" : "BAD", after ? "ok" : "BAD", probe.cleaned);
+    }
+  }
+  if (!s_hbxProbes.empty() && s_hbxProbeTotal % 128 == 0) {
+    for (int cleaned = 0; cleaned < 2; ++cleaned) {
+      const auto& c = s_hbxProbeCounts[cleaned];
+      Log.info("upload probe totals, cache clean {}: all ok {}, staging bad {}, copy bad {}, wiped later {}, other {}",
+               cleaned != 0, c[7], c[0] + c[1] + c[2] + c[3], c[4] + c[5], c[6], 0);
+    }
+  }
+  s_hbxProbes.clear();
