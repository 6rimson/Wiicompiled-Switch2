+  const uint32_t rows = item.size.height;
+  const uint32_t alignedRow = AURORA_ALIGN(bytesPerRow, 256);
+  const uint32_t bytes = std::min<uint32_t>(bytesPerRow, 256) & ~3u;
+  const uint8_t* cpu = frame.textureUpload.data() + item.layout.offset;
+  for (const uint32_t row : {rows / 2, rows / 4, rows * 3 / 4, 0u, rows - 1}) {
