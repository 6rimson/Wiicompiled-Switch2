+bool hbx_read_buffer(const wgpu::Buffer& buffer, uint64_t size) {
+  bool ok = false;
+  const auto future = buffer.MapAsync(wgpu::MapMode::Read, 0, size, wgpu::CallbackMode::WaitAnyOnly,
+                                      [&ok](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                                        ok = status == wgpu::MapAsyncStatus::Success;
+                                      });
+  return webgpu::g_instance.WaitAny(future, 5000000000) == wgpu::WaitStatus::Success && ok;
+}
+
+void hbx_check_texture(HbxCheck& check, TextureRef& ref, bool first) {
+  const uint32_t alignedRow = AURORA_ALIGN(check.bytesPerRow, 256);
+  const uint64_t bytes = uint64_t{alignedRow} * check.rows;
+  const wgpu::BufferDescriptor descriptor{.label = "HBX texture check",
+                                          .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                                          .size = bytes};
+  auto buffer = webgpu::g_device.CreateBuffer(&descriptor);
+  auto encoder = webgpu::g_device.CreateCommandEncoder();
+  const wgpu::TexelCopyTextureInfo source{.texture = ref.texture};
+  const wgpu::TexelCopyBufferInfo target{.layout = {.bytesPerRow = alignedRow, .rowsPerImage = check.rows},
+                                         .buffer = buffer};
+  encoder.CopyTextureToBuffer(&source, &target, &check.size);
+  const auto commands = encoder.Finish();
+  webgpu::g_queue.Submit(1, &commands);
+  if (!hbx_read_buffer(buffer, bytes)) {
+    Log.warn("texture check: readback failed for {}x{}", ref.size.width, ref.size.height);
+    return;
+  }
+  const auto* mapped = static_cast<const uint8_t*>(buffer.GetConstMappedRange(0, bytes));
+  std::vector<uint8_t> tight(uint64_t{check.bytesPerRow} * check.rows);
+  for (uint32_t row = 0; row < check.rows; ++row) {
+    std::memcpy(tight.data() + uint64_t{row} * check.bytesPerRow, mapped + uint64_t{row} * alignedRow,
+                check.bytesPerRow);
+  }
+  ++s_hbxChecked;
+  if (XXH3_64bits(tight.data(), tight.size()) != check.hash) {
+    const auto zero = std::count(tight.begin(), tight.end(), uint8_t{0});
+    const uint64_t index = s_hbxBad++;
+    Log.warn("texture check {}: {}x{} gx format {} wgpu {} mips {}: GPU contents differ, {:.1f}% zero bytes ({})", index,
+             ref.size.width, ref.size.height, ref.gxFormat, static_cast<int>(ref.format), ref.mipCount,
+             100.0 * static_cast<double>(zero) / static_cast<double>(tight.size()), first ? "new" : "was correct before");
+    if (index < 24) {
+      const auto path = fmt::format("/UserData/Captures/bad_{:03}_{}x{}_gx{}_row{}.raw", index, ref.size.width,
+                                    ref.size.height, ref.gxFormat, check.bytesPerRow);
+      if (std::FILE* file = std::fopen(path.c_str(), "wb")) {
+        std::fwrite(tight.data(), 1, tight.size(), file);
+        std::fclose(file);
+      }
+    }
+  }
+  if ((s_hbxChecked & 255) == 0) {
+    Log.info("texture check: {} checked, {} differ, {} skipped", s_hbxChecked, s_hbxBad, s_hbxDropped);
+  }
+}
+
+void hbx_verify_enqueue(const TextureHandle& handle, const uint8_t* data, uint32_t bytesPerRow, uint32_t rows,
+                        wgpu::Extent3D size) {
+  if (!hbx_verify_enabled()) {
+    return;
+  }
+  const uint64_t hash = XXH3_64bits(data, uint64_t{bytesPerRow} * rows);
+  std::lock_guard lock{s_hbxCheckMutex};
+  if (s_hbxPending.size() >= 128) {
+    ++s_hbxDropped;
+    return;
+  }
+  s_hbxPending.push_back({.strong = handle,
+                          .hash = hash,
+                          .bytesPerRow = bytesPerRow,
+                          .rows = rows,
+                          .size = size,
+                          .readyAt = s_hbxFrames.load(std::memory_order_relaxed) + 3});
+}
+} // namespace
+
+void hbx_verify_process() noexcept {
+  if (!hbx_verify_enabled()) {
+    return;
+  }
+  const uint32_t frame = s_hbxFrames.fetch_add(1, std::memory_order_relaxed);
+  for (int i = 0; i < 4; ++i) {
+    HbxCheck check;
+    {
+      std::lock_guard lock{s_hbxCheckMutex};
+      if (s_hbxPending.empty() || static_cast<int32_t>(frame - s_hbxPending.front().readyAt) < 0) {
+        break;
+      }
+      check = std::move(s_hbxPending.front());
+      s_hbxPending.pop_front();
+    }
+    hbx_check_texture(check, *check.strong, true);
+    check.weak = check.strong;
+    check.strong = {};
+    std::lock_guard lock{s_hbxCheckMutex};
+    if (s_hbxRecheck.size() < 4096) {
+      s_hbxRecheck.push_back(std::move(check));
+    }
+  }
+  if ((frame % 30) == 0) {
+    for (int i = 0; i < 2; ++i) {
+      HbxCheck check;
+      {
+        std::lock_guard lock{s_hbxCheckMutex};
+        if (s_hbxRecheck.empty()) {
+          break;
+        }
+        check = std::move(s_hbxRecheck.front());
+        s_hbxRecheck.pop_front();
+      }
+      if (const auto ref = check.weak.lock()) {
+        hbx_check_texture(check, *ref, false);
+        std::lock_guard lock{s_hbxCheckMutex};
+        s_hbxRecheck.push_back(std::move(check));
+      }
+    }
+  }
+}
+
+bool hbx_capture_frame(uint32_t frame) noexcept { return hbx_capture_enabled() && frame % 300 == 150; }
+
+std::FILE* hbx_draw_file(uint32_t frame) noexcept {
+  static std::FILE* file = nullptr;
+  static uint32_t fileFrame = UINT32_MAX;
+  if (frame != fileFrame) {
+    if (file != nullptr) {
+      std::fclose(file);
+    }
+    fileFrame = frame;
+    file = std::fopen(fmt::format("/UserData/Captures/draws_{:06}.txt", frame).c_str(), "w");
+  }
+  return file;
+}
+
+wgpu::Buffer hbx_capture_encode(wgpu::CommandEncoder& encoder, const wgpu::Texture& texture, wgpu::Extent3D size) {
+  const uint32_t row = AURORA_ALIGN(size.width * 4, 256);
+  const wgpu::BufferDescriptor descriptor{.label = "HBX frame capture",
+                                          .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+                                          .size = uint64_t{row} * size.height};
+  auto buffer = webgpu::g_device.CreateBuffer(&descriptor);
+  const wgpu::TexelCopyTextureInfo source{.texture = texture};
+  const wgpu::TexelCopyBufferInfo target{.layout = {.bytesPerRow = row, .rowsPerImage = size.height}, .buffer = buffer};
+  const wgpu::Extent3D extent{size.width, size.height, 1};
+  encoder.CopyTextureToBuffer(&source, &target, &extent);
+  return buffer;
+}
+
+void hbx_capture_finish(const wgpu::Buffer& buffer, wgpu::Extent3D size, uint32_t frame) noexcept {
+  const uint32_t row = AURORA_ALIGN(size.width * 4, 256);
+  const uint64_t bytes = uint64_t{row} * size.height;
+  if (!hbx_read_buffer(buffer, bytes)) {
+    return;
+  }
+  const auto path = fmt::format("/UserData/Captures/frame_{:06}_{}x{}_row{}.raw", frame, size.width, size.height, row);
+  if (std::FILE* file = std::fopen(path.c_str(), "wb")) {
+    std::fwrite(buffer.GetConstMappedRange(0, bytes), 1, bytes, file);
+    std::fclose(file);
+  }
+  buffer.Unmap();
+}
