+/* HBLauncher range protocol v1. Included after the upstream SVC declarations.
+ * No new SVCs, process launches, filesystem writes, or persistent state.
+ * One kernel mapping per request; no speculative page-by-page fallback.
+ */
+#define HBL_MAP_RX 0x524f001au
+#define HBL_MAP_RW 0x524f001bu
+#define HBL_UNMAP  0x524f001cu
+#define HBL_PAGE 0x1000ULL
+#define HBL_MAX_PAGES 16384ULL
+
+static int hbl_contains(const MemoryInfo *info, u64 address, u64 size) {
+    /* Subtraction avoids overflow and permits an exact end-of-region match. */
+    return info->size && address >= info->address &&
+        address - info->address < info->size &&
+        size <= info->size - (address - info->address);
+}
+
+static u32 hbl_range(u32 command, const u64 *input, u32 bytes, u32 handle,
+    u64 caller_pid, const Reply *pid, const MemoryInfo *source_info,
+    u64 *out, u32 *output_bytes) {
+    /* out[0..2] are the upstream identity fields. out[3] is completed pages;
+     * [4] failure page (0: whole-range operation), [5] primary failure,
+     * [6] failure count, [7] rollback result, [8] mode (1: contiguous SVC).
+     * A nonzero result always means stop; out[3] can describe retained pages.
+     */
+    *output_bytes = 72;
+    for (u32 i = 3; i < 9; i++) out[i] = 0;
+    out[8] = 1;
+    u64 source = input[1], destination = input[2], pages = input[3];
+    /* The kernel-inserted IPC PID must match the copied target process handle.
+     * New operations can only modify the requesting application, never FS/RO.
+     * Keep every legacy command's contract unchanged.
+     */
+    /* CMIF raw-data length includes up to 16 bytes of alignment padding. */
+    if (bytes < 32 || bytes > 48 || !caller_pid || caller_pid != pid->value ||
+        input[0] != caller_pid || !source || !destination ||
+        (source | destination) & (HBL_PAGE - 1) ||
+        !pages || pages > HBL_MAX_PAGES) goto invalid;
+    for (u32 i = 32; i < bytes; i++)
+        if (((const unsigned char *)input)[i]) goto invalid;
+    u64 size = pages * HBL_PAGE;
+    if (source > ~0ULL - size || destination > ~0ULL - size ||
+        (source < destination + size && destination < source + size) ||
+        !hbl_contains(source_info, source, size) || source_info->type != 5 ||
+        source_info->ipc_refs || source_info->device_refs) goto invalid;
+
+    MemoryInfo target = {0};
+    Reply q = query_process(&target, handle, destination);
+    u32 result = (u32)q.result;
+    if (result) goto failed;
+    if (!hbl_contains(&target, destination, size) || target.ipc_refs ||
+        target.device_refs || target.attributes) goto invalid;
+
+    if (command == HBL_UNMAP) {
+        if (source_info->permission != 0 || source_info->attributes != 1 ||
+            (target.type != 8 && target.type != 9) ||
+            (target.permission != 0 && target.permission != 3 && target.permission != 5))
+            goto invalid;
+        /* The kernel checks that source/destination describe the same pages. */
+        result = unmap_code(handle, destination, source, size);
+        if (result) goto failed;
+        out[3] = pages;
+        return 0;
+    }
+
+    if (source_info->permission != 3 || source_info->attributes ||
+        target.type != 0 || target.permission) goto invalid;
+    result = map_code(handle, destination, source, size);
+    if (result) goto failed;
+    out[3] = pages;
+    u32 permission = command == HBL_MAP_RX ? 5 : 3;
+    result = process_permission(handle, destination, size, permission);
+    if (!result) {
+        MemoryInfo after = {0};
+        q = query_process(&after, handle, destination);
+        result = (u32)q.result;
+        if (!result && (!hbl_contains(&after, destination, size) ||
+            after.type != (permission == 5 ? 8u : 9u) ||
+            after.permission != permission || after.attributes ||
+            after.ipc_refs || after.device_refs)) result = BAD_INPUT;
+    }
+    if (!result) return 0;
+    /* Roll back only a mapping this request successfully created. Do not
+     * retry a failed rollback; report the retained pages to the host.
+     */
+    out[7] = unmap_code(handle, destination, source, size);
+    if (!out[7]) out[3] = 0;
+    else out[6] = 1;
+    out[5] = result;
+    return result;
+
+invalid:
+    result = BAD_INPUT;
+failed:
+    out[5] = result;
+    out[6] = 1;
+    return result;
+}
