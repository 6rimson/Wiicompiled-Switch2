+/* Execute the actual production process_request with simulated kernel SVCs.
+ * This checks our validation, wire results and rollback decisions, not the
+ * retail kernel's implementation. No console connection or privileged calls.
+ */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../engine/switch2/ro/payload/process.c"
+
+#define SOURCE 0x100000000ULL
+#define DEST 0x40000000ULL
+#define EXTENT 0x8001000ULL
+#define PID 123ULL
+#define FAULT 0x123401u
+typedef struct { u64 source, destination, size; u32 permission; } Mapping;
+static Mapping mappings[8];
+static u32 map_calls, unmap_calls, permission_calls, query_calls;
+static u32 map_fault, unmap_fault, permission_fault, query_fault_at;
+static u32 pid_fault, program_fault, wrong_readback;
+static MemoryInfo source_override, target_override;
+static int override_source, override_target;
+static u64 process_pid, process_program;
+static unsigned cases;
+
+static void reset(void) {
+    memset(mappings, 0, sizeof(mappings));
+    map_calls = unmap_calls = permission_calls = query_calls = 0;
+    map_fault = unmap_fault = permission_fault = query_fault_at = 0;
+    pid_fault = program_fault = wrong_readback = 0;
+    override_source = override_target = 0;
+    process_pid = PID; process_program = 0x0100000000001000ULL;
+    cases++;
+}
+Reply process_id(u32 handle) { assert(handle == 42); return (Reply){pid_fault, process_pid}; }
+Reply get_info(u32 type, u32 handle, u64 subtype) {
+    (void)handle; (void)subtype;
+    return (Reply){program_fault, type == 18 ? process_program : 0};
+}
+Reply query_memory(MemoryInfo *info, u64 address) { (void)info; (void)address; return (Reply){FAULT, 0}; }
+u32 map_process(u64 d, u32 h, u64 s, u64 n) { (void)d;(void)h;(void)s;(void)n; assert(0); return FAULT; }
+u32 unmap_process(u64 d, u32 h, u64 s, u64 n) { (void)d;(void)h;(void)s;(void)n; assert(0); return FAULT; }
+
+Reply query_process(MemoryInfo *info, u32 handle, u64 address) {
+    assert(handle == 42);
+    query_calls++;
+    if (query_fault_at == query_calls) return (Reply){FAULT,0};
+    memset(info, 0, sizeof(*info));
+    if (address >= SOURCE && address < SOURCE + EXTENT) {
+        if (override_source) { *info = source_override; return (Reply){0,0}; }
+        info->address = SOURCE; info->size = EXTENT; info->type = 5; info->permission = 3;
+        for (u32 i = 0; i < 8; i++) if (mappings[i].size) {
+            Mapping m = mappings[i];
+            if (address >= m.source && address < m.source + m.size) {
+                info->address = m.source; info->size = m.size;
+                info->permission = 0; info->attributes = 1; return (Reply){0,0};
+            }
+            if (m.source > address && m.source < info->address + info->size)
+                info->size = m.source - info->address;
+            if (m.source + m.size <= address && m.source + m.size > info->address) {
+                u64 end = info->address + info->size;
+                info->address = m.source + m.size; info->size = end - info->address;
+            }
+        }
+        return (Reply){0,0};
+    }
+    if (override_target) { *info = target_override; return (Reply){0,0}; }
+    info->address = 0x1000; info->size = SOURCE - 0x1000;
+    for (u32 i = 0; i < 8; i++) if (mappings[i].size) {
+        Mapping m = mappings[i];
+        if (address >= m.destination && address < m.destination + m.size) {
+            info->address = m.destination; info->size = m.size;
+            info->type = m.permission == 3 ? 9 : 8;
+            info->permission = wrong_readback ? 7 : m.permission;
+            return (Reply){0,0};
+        }
+        if (m.destination > address && m.destination < info->address + info->size)
+            info->size = m.destination - info->address;
+        if (m.destination + m.size <= address && m.destination + m.size > info->address) {
+            u64 end = info->address + info->size;
+            info->address = m.destination + m.size; info->size = end - info->address;
+        }
+    }
+    return (Reply){0,0};
+}
+u32 map_code(u32 handle, u64 destination, u64 source, u64 size) {
+    assert(handle == 42); map_calls++;
+    if (map_fault) return map_fault;
+    for (u32 i=0; i<8; i++) if (!mappings[i].size) {
+        mappings[i] = (Mapping){source,destination,size,0}; return 0;
+    }
+    assert(0); return FAULT;
+}
+u32 process_permission(u32 handle, u64 address, u64 size, u32 permission) {
+    assert(handle == 42); permission_calls++;
+    if (permission_fault) return permission_fault;
+    for (u32 i=0; i<8; i++) if (mappings[i].size == size && mappings[i].destination == address) {
+        mappings[i].permission = permission; return 0;
+    }
+    assert(0); return FAULT;
+}
+u32 unmap_code(u32 handle, u64 destination, u64 source, u64 size) {
+    assert(handle == 42); unmap_calls++;
+    if (unmap_fault) return unmap_fault;
+    for (u32 i=0; i<8; i++) if (mappings[i].size == size && mappings[i].source == source && mappings[i].destination == destination) {
+        mappings[i].size = 0; return 0;
+    }
+    return FAULT;
+}
+static u64 out[24];
+static u32 output_bytes;
+static u32 request(u32 command, u64 source, u64 destination, u64 pages, u64 sender, u32 bytes) {
