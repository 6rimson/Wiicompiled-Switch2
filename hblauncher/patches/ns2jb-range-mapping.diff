+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const {createRequire} = require('node:module');
+const {packet, response} = require('../engine/shared/ipc.cjs');
+test('actual CMIF packet contains 32 argument bytes and 8 padding bytes',()=>{
+  const input=Buffer.alloc(32);[123,0x100000000,0x40000000,2].forEach((v,i)=>input.writeBigUInt64LE(BigInt(v),i*8));
+  const bytes=packet(0x524f001a,input,{pid:true,copies:[0xffff8001]});
+  assert.equal(bytes.readUInt32LE(8),3);
+  bytes.writeBigUInt64LE(123n,12); // What the kernel writes into the PID descriptor.
+  const beforeAlignment=6, at=8, end=beforeAlignment+(bytes.readUInt32LE(4)&0x3ff);
+  assert.equal((end-at-4)*4,40);
+  assert.equal(bytes.readBigUInt64LE(12),123n);
+  assert(bytes.subarray((at+4)*4,(at+4)*4+32).equals(input));
+  assert(bytes.subarray((at+4)*4+32,end*4).equals(Buffer.alloc(8)));
+});
+test('72-byte range reply survives the upstream reply decoder',()=>{
+  const bytes=Buffer.alloc(256);bytes.writeUInt32LE((0x80000000|26)>>>0,4);bytes.writeUInt32LE(1,8);
+  bytes.writeBigUInt64LE(209n,12);bytes.write('SFCO',32);bytes.writeUInt32LE(0,40);
+  [123n,1n,0n,16384n,0n,0n,0n,0n,1n].forEach((v,i)=>bytes.writeBigUInt64LE(v,48+i*8));
+  const reply=response(bytes);assert.equal(reply.result,0);assert.equal(reply.data.readBigUInt64LE(24),16384n);
+  assert.equal(reply.data.readBigUInt64LE(64),1n);
+});
+function harness(){
+  const file=path.resolve(__dirname,'../engine/switch2/ro/worker-control.cjs');
+  const realRequire=createRequire(file), writes=[], started=[];
+  const fakeRequire=name=>{
+    if(name.endsWith('/native-worker.cjs'))return {start:async(...args)=>{started.push(args);return {thread:1};}};
+    if(name.endsWith('/events.cjs'))return {verify:async()=>{},initialize:async()=>{},code:{wait:{offset:0x100}}};
+    if(name.endsWith('/worker.cjs'))return {verifyWorkerCode:async()=>{}};
+    return realRequire(name);
+  };
+  const module={exports:{}};
+  vm.runInNewContext(fs.readFileSync(file,'utf8'),{require:fakeRequire,module,exports:module.exports,__dirname:path.dirname(file),Buffer,Date});
+  const s={base:0x100000000,bytes:0x3000000,threads:new Set(),handles:new Set([7,8]),write:async(address,bytes)=>writes.push({address,bytes})};
+  const state={services:[{name:'ro:dmnt',handle:7}]};
