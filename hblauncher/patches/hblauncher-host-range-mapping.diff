+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {LiveTarget} = require('../../host/lib/target.cjs');
+const PAGE = 4096, SOURCE = 0x100000000, DEST = 0x40000000;
+function fixture(replyFn) {
+  const target = new LiveTarget({});
+  const requests = [], frees = [];
+  target.pid = 123;
+  target.rpc = {
+    query: async () => ({address: 0x1000, size: 0x7ffff000, type: 0}),
+    call: async (fn, args) => { frees.push(args[0]); return {result: 0n}; },
+    read: async () => Buffer.alloc(0),
+  };
+  target.client = {pending: false, request: async (id, handle, values) => {
+    requests.push({id,handle,values});
+    if (replyFn) return replyFn(requests.length, id, values, target);
+    return {result: 0, values: [123n,1n,0n,BigInt(values[3]),0n,0n,0n,0n,1n]};
+  }};
+  return {target,requests,frees};
+}
+const entry = (pages=2, permission=5) => ({source:SOURCE,destination:DEST,bytes:pages*PAGE,permission});
+test('RX and RW wire contracts and full cleanup', async () => {
+  for (const permission of [3,5]) {
+    const {target,requests,frees} = fixture(); const e=entry(2,permission);
+    await target.mapImage(e);
+    assert.deepEqual(requests[0],{id:permission===5?0x524f001a:0x524f001b,handle:0xffff8001,values:[123,SOURCE,DEST,2]});
+    await assert.rejects(target.free(SOURCE),/still be mapped/);
+    assert.equal(frees.length,0);
+    await target.unmapImage(e);
+    assert.equal(requests[1].id,0x524f001c);
+    await target.free(SOURCE); assert.deepEqual(frees,[SOURCE]);
+  }
+});
+test('game-sized image maps and unmaps in two bounded requests',async()=>{
+  const {target,requests}=fixture();const e=entry(31083);
+  await target.mapImage(e);
+  assert.deepEqual(requests.map(r=>r.values.slice(1)),[[SOURCE,DEST,16384],[SOURCE+0x4000000,DEST+0x4000000,14699]]);
+  await target.unmapImage(e);
+  assert.equal(requests.length,4);assert.equal(target.retainedSources.size,0);
+});
+test('partial final page rounds up and region offset is respected',async()=>{
+  const {target,requests}=fixture();
+  target.rpc.query=async()=>({address:DEST-PAGE,size:PAGE*3,type:0});
+  await target.mapImage({...entry(),bytes:PAGE+1});assert.equal(requests[0].values[3],2);
+});
+test('source is retained before the first request can lose its reply',async()=>{
+  const {target,requests,frees}=fixture(async(n,id,v,t)=>{
+    assert(t.retainedSources.has(SOURCE));t.client.pending=true;throw Error('lost reply');
+  });
+  await assert.rejects(target.mapImage(entry()),/lost reply/);
+  await assert.rejects(target.free(SOURCE),/unresolved/);
+  await assert.rejects(target.mapImage(entry()),/unresolved/);
+  await assert.rejects(target.unmapImage(entry()),/unresolved/);
+  assert.equal(requests.length,1);assert.equal(frees.length,0);
+});
+test('second-chunk failure cannot free the first chunk or replay mutations',async()=>{
+  const {target,requests,frees}=fixture(async(n,id,v)=>{
+    if(n===2) throw Error('second chunk failed');
+    return {result:0,values:[123n,1n,0n,BigInt(v[3]),0n,0n,0n,0n,1n]};
+  });
+  await assert.rejects(target.mapImage(entry(31083)),/second chunk/);
+  assert.equal(target.mapped[0].confirmedPages,16384);
+  await assert.rejects(target.free(SOURCE),/unresolved/);
+  await assert.rejects(target.call(DEST,[0]),/unresolved/);
+  assert.equal(requests.length,2);assert.equal(frees.length,0);
+});
+test('native permission/rollback failure fails closed',async()=>{
+  const {target,frees}=fixture(async()=>({result:0xd401,values:[123n,1n,0n,2n,0n,0xd401n,1n,0xd401n,1n]}));
+  await assert.rejects(target.mapImage(entry()),/map RX/);
+  await assert.rejects(target.free(SOURCE),/unresolved/);assert.equal(frees.length,0);
+});
+test('short response and incorrect count are not success',async()=>{
+  for(const values of [[123n,1n,0n,2n],[123n,1n,0n,1n,0n,0n,0n,0n,1n]]){
+    const {target}=fixture(async()=>({result:0,values}));
+    await assert.rejects(target.mapImage(entry()),/map RX/);
+    assert(target.retainedSources.has(SOURCE));
+  }
+});
+test('unmap failure performs no fallback and keeps the allocation',async()=>{
+  const {target,requests,frees}=fixture(async(n,id,v)=>({result:n>1?0xd401:0,values:[123n,1n,0n,n>1?0n:BigInt(v[3]),0n,0n,n>1?1n:0n,0n,1n]}));
+  await target.mapImage(entry());
+  await assert.rejects(target.unmapImage(entry()),/unmap/);
+  await assert.rejects(target.free(SOURCE),/unresolved/);
+  assert.equal(requests.length,2);assert.equal(frees.length,0);
+});
+test('partial successful unmap across chunks still retains source on next failure',async()=>{
+  const {target,requests}=fixture(async(n,id,v)=>{
+    if(n===4)throw Error('unmap response lost');
+    return {result:0,values:[123n,1n,0n,BigInt(v[3]),0n,0n,0n,0n,1n]};
+  });
+  const e=entry(31083);await target.mapImage(e);
+  await assert.rejects(target.unmapImage(e),/lost/);
+  await assert.rejects(target.free(SOURCE),/unresolved/);assert.equal(requests.length,4);
+});
+test('successful status with a short unmap count is rejected',async()=>{
+  const {target}=fixture(async(n,id,v)=>({result:0,values:[123n,1n,0n,n>1?1n:BigInt(v[3]),0n,0n,0n,0n,1n]}));
+  await target.mapImage(entry());await assert.rejects(target.unmapImage(entry()),/unmap/);
+});
+test('occupied or undersized destination causes no mutation',async()=>{
+  for(const region of [{address:DEST,size:PAGE,type:0},{address:DEST,size:PAGE*2,type:5}]){
+    const {target,requests}=fixture();target.rpc.query=async()=>region;
+    await assert.rejects(target.mapImage(entry()),/not free/);
+    assert.equal(requests.length,0);assert.equal(target.retainedSources.size,0);
+  }
+});
+test('malformed requests are rejected before contacting the process client',async()=>{
+  for(const change of [{source:SOURCE+1},{destination:DEST+1},{bytes:0},{bytes:-1},{bytes:NaN},{permission:7},{bytes:Number.MAX_SAFE_INTEGER}]){
+    const {target,requests}=fixture();await assert.rejects(target.mapImage({...entry(),...change}));
+    assert.equal(requests.length,0);
+  }
+});
+test('unknown mappings cannot be unmapped',async()=>{
+  const {target,requests}=fixture();await assert.rejects(target.unmapImage(entry()),/complete mapping/);
+  assert.equal(requests.length,0);
+});
+test('failure marker blocks reopening the same run before any connection',async(t)=>{
+  const fs=require('node:fs'),os=require('node:os'),path=require('node:path');
+  const dir=fs.mkdtempSync(path.join(os.tmpdir(),'hbl-range-test-'));
+  t.after(()=>fs.rmSync(dir,{recursive:true,force:true}));
+  const {target}=fixture(async()=>{throw Error('uncertain mapping');});target.runDir=dir;
+  await assert.rejects(target.mapImage(entry()),/uncertain mapping/);
+  assert(fs.existsSync(path.join(dir,'hbl-mapping-uncertain.json')));
+  await assert.rejects(LiveTarget.open({runDir:dir}),/unresolved mapping failure/);
+});
