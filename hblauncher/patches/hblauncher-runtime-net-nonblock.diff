+#define NET_O_NONBLOCK 0x800
+#define NET_TRACKED_FDS 256
+
+/* Remembered here too, so a read or send on a non-blocking socket can't wait
+ * even if the service ignores the flag: one stuck call stops the whole game. */
+static uint8_t g_net_nonblock[NET_TRACKED_FDS];
+
+static int net_is_nonblock(int fd) {
+    return fd >= 0 && fd < NET_TRACKED_FDS && g_net_nonblock[fd];
+}
+
 static long net_nonblock(int fd, int on) {
     int flags = HBXL_CALL(IMP_SOCK_FCNTL, int (*)(int, int, int))(fd, 3, 0);
+    long r;
     if (flags < 0) return -net_errno();
-    flags = on ? (flags | 4) : (flags & ~4);
-    return net_result(HBXL_CALL(IMP_SOCK_FCNTL, int (*)(int, int, int))(fd, 4, flags));
+    flags = on ? (flags | NET_O_NONBLOCK) : (flags & ~NET_O_NONBLOCK);
+    r = net_result(HBXL_CALL(IMP_SOCK_FCNTL, int (*)(int, int, int))(fd, 4, flags));
+    if (r >= 0 && fd >= 0 && fd < NET_TRACKED_FDS) g_net_nonblock[fd] = on != 0;
+    hbxl_logf("hbxl: net nonblock fd %d on %d: set %d, reads back %x", (int64_t)fd, (int64_t)on, (int64_t)r,
+              (uint64_t)(uint32_t)HBXL_CALL(IMP_SOCK_FCNTL, int (*)(int, int, int))(fd, 3, 0));
+    return r;
 }
 
