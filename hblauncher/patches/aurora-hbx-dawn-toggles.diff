 namespace aurora::webgpu {
 static Module Log("aurora::gpu");
+
+#if defined(HBX_SWITCH2)
+// HBLauncher (Switch 2): extra Dawn device toggles from the environment (hbxl-env), comma-separated,
+// so toggle experiments need no rebuild: AURORA_DAWN_ENABLE and AURORA_DAWN_DISABLE.
+static std::deque<std::string> g_hbxToggleNames; // stable storage for the toggle names
+
+static void hbx_append_toggles(const char* variable, std::vector<const char*>& toggles) {
+  const char* value = std::getenv(variable);
+  if (value == nullptr) {
+    return;
+  }
+  std::string_view rest{value};
+  while (!rest.empty()) {
+    const auto comma = rest.find(',');
+    const auto name = rest.substr(0, comma);
+    if (!name.empty()) {
+      toggles.push_back(g_hbxToggleNames.emplace_back(name).c_str());
+      Log.info("{}: {}", variable, name);
+    }
+    if (comma == std::string_view::npos) {
+      break;
+    }
+    rest.remove_prefix(comma + 1);
+  }
+}
+#endif
 
