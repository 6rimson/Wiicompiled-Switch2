+#if defined(HBX_SWITCH2)
+// Counts every texture upload and how many had an all-zero source, for the runtime's
+// MKW_PERF_STATS report, and describes the first uploads in the log.
+void hbx_note_texture_miss(const GXTexObj_& obj, size_t bytes) noexcept {
+  const auto* data = static_cast<const uint8_t*>(obj.data);
+  const bool zero = std::all_of(data, data + bytes, [](uint8_t value) { return value == 0; });
+  const uint64_t count = aurora_hbx_tex_misses.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (zero) {
+    aurora_hbx_tex_zero.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (count <= 200 || (zero && count <= 2000)) {
+    Log.info("texture upload {}: format {} {}x{} mips {} {} KiB{}", count, static_cast<int>(obj.format()), obj.width(),
+             obj.height(), obj.mip_count(), bytes / 1024, zero ? " ALL ZERO" : "");
+  }
 }
+#endif
 
