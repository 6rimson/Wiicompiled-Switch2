+// HBLauncher (Switch 2): the console's driver sometimes refuses a pipeline (VK_ERROR_UNKNOWN, a
+// different one every run). Catch that here instead of letting the uncaptured-error callback end
+// the game; the pipeline cache skips the pipeline's draws and retries it later.
+static bool pop_hbx_scope(std::string& error) {
+  auto message = std::make_shared<std::string>();
+  auto future = g_device.PopErrorScope(
+      wgpu::CallbackMode::WaitAnyOnly,
+      [message](wgpu::PopErrorScopeStatus status, wgpu::ErrorType type, wgpu::StringView text) {
+        if (status != wgpu::PopErrorScopeStatus::Success || type != wgpu::ErrorType::NoError) {
+          const std::string_view detail{text};
+          *message = detail.empty() ? "pipeline creation failed" : std::string(detail);
+        }
+      });
+  if (webgpu::g_instance.WaitAny(future, 5000000000) != wgpu::WaitStatus::Success) {
+    error = "timed out checking pipeline creation";
+    return false;
+  }
+  if (!message->empty()) {
+    error = *message;
+    return false;
+  }
+  return true;
+}
+
+// The largest free block in the SDK heap (which the driver allocates from), to the nearest power of two.
+static uint32_t hbx_sdk_heap_free_mib() {
+  for (uint32_t mib = 128; mib >= 1; mib /= 2) {
+    if (void* p = hbxl_sdk_memalign(4096, size_t{mib} << 20)) {
+      hbxl_sdk_free(p);
+      return mib;
+    }
+  }
+  return 0;
+}
